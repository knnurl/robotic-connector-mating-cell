<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>melfa_rv5as_masterclass</name>
  <version>1.0.0</version>
  <description>ROS-I AP Annual Summit 2024 Masterclass</description>
  <maintainer email="Muyao.Liu@asia.meap.com">Liu Muyao</maintainer>
  <license>Apache License 2.0</license>

  <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>python3</depend>
  <depend>python3-colcon-common-extensions</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>melfa_msgs</depend>
  <depend>melfa_masterclass_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Additional Python dependencies -->
  <exec_depend>opencv-python</exec_depend>
  <exec_depend>pyrealsense2</exec_depend>
  <exec_depend>numpy</exec_depend>
  <exec_depend>pyyaml</exec_depend>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Export build type -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

